# --- Core Runtime ---
SMAI_TIMEZONE=Asia/Karachi
SMAI_DEFAULT_BRAND=default
SMAI_DATA_DIR=./data
SMAI_EXPORT_DIR=./exports
SMAI_LOG_LEVEL=INFO

# --- LLM Provider (gemini | openai | anthropic | ollama | mock) ---
SMAI_LLM_PROVIDER=gemini
SMAI_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- TTS & Audio ---
SMAI_TTS_PROVIDER=edge
SMAI_TTS_VOICE=en-US-ChristopherNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock Media ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Publishing & Public Media Staging (Meta Graph API) ---
SMAI_PUBLISH_MODE=export
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v27.0
IG_WEBHOOK_VERIFY_TOKEN=
SMAI_PUBLIC_MEDIA_BASE_URL=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
